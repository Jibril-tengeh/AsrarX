{
	"appId": "com.asrarhub.app",
	"appName": "AsrarHub",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true,
		"allowNavigation": [
			"*"
		]
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		},
		"CapacitorCookies": {
			"enabled": true
		}
	},
	"packageClassList": [
		"AppPlugin",
		"FilesystemPlugin",
		"HapticsPlugin",
		"SharePlugin"
	]
}
